# Copia este archivo a .env.local y complétalo. NUNCA subas .env.local a Git.
#
# --- Frontend (Vite / Cloudflare Pages) -------------------------------------
# Solo variables públicas. La clave anon de Supabase es pública por diseño:
# la seguridad la da Row Level Security, no el secreto de esta clave.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=

# --- Edge Functions de Supabase ---------------------------------------------
# Se configuran con `supabase secrets set`, NO en este archivo ni en Cloudflare.
#   SUPABASE_URL              (la inyecta Supabase automáticamente)
#   SUPABASE_SERVICE_ROLE_KEY (la inyecta Supabase automáticamente)
#   RESEND_API_KEY=           clave de API de Resend
#   CORREO_REMITENTE=         p. ej. "Sánchez Contadores <reservas@tu-dominio.do>"
#   CORREO_CONTADORA=         destino de las copias internas
#   APP_URL=                  URL pública del sitio, para los enlaces del correo
#   CRON_SECRET=              secreto compartido con el cron de recordatorios
