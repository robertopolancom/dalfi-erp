# Copia este archivo a .env y complétalo para desarrollo local.
# NUNCA subas .env a Git.

# --- Base de datos (Neon) ----------------------------------------------------
# En producción es la cadena del endpoint con pooling de Neon. En local, un
# Postgres cualquiera. Es el secreto más sensible del sistema: nunca sale del
# servidor, no llega al navegador ni se escribe en logs.
DATABASE_URL=
PG_POOL_MAX=5

# --- Correo (Resend) ---------------------------------------------------------
# Se usa la API HTTP, no SMTP: Render bloquea los puertos 465 y 587.
RESEND_API_KEY=
CORREO_REMITENTE=Sánchez Contadores <reservas@tu-dominio.do>
CORREO_CONTADORA=

# --- Aplicación --------------------------------------------------------------
# Base de los enlaces que van dentro de los correos.
# En producción: https://sanchezcontadores.sebengroup.com
APP_URL=http://localhost:5173
PORT=3000

# --- Cloudflare delante de Render (solo en producción) -----------------------
# Deja las tres vacías en local. Ver README, sección "Despliegue".
#   SALTOS_DE_PROXY=2        proxies encadenados (Cloudflare + Render)
#   DETRAS_DE_CLOUDFLARE=1   lee la IP real de CF-Connecting-IP
#   DOMINIO_CANONICO=sanchezcontadores.sebengroup.com

# Protege POST /api/cron/recordatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# El frontend NO necesita variables: se sirve desde el mismo origen que la API
# y usa rutas relativas.
