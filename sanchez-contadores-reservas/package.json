{
  "name": "sanchez-contadores-reservas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --experimental-strip-types --watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node dist-server/server/index.js",
    "preview": "vite preview",
    "lint": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrar": "bash neon/migrar.sh",
    "db:test": "RECREAR=1 bash neon/tests/run.sh",
    "admin:crear": "node --experimental-strip-types scripts/crear-admin.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
