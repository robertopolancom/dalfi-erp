# Variables publicas de configuracion
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_PROVIDER=apps_script
GOOGLE_CALENDAR_ID=dalfistudionails@gmail.com
GOOGLE_CALENDAR_TIME_ZONE=America/Santo_Domingo
GOOGLE_CALENDAR_TIMEOUT_MS=8000
GOOGLE_CALENDAR_MAX_SYNC_PER_SAVE=25
GOOGLE_CALENDAR_SYNC_SECRET=CONFIGURAR_COMO_SECRETO_EN_CLOUDFLARE

# Proveedor recomendado: Apps Script. Configurar ambos como secretos.
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
GOOGLE_APPS_SCRIPT_WEBHOOK_SECRET=CONFIGURAR_COMO_SECRETO_EN_CLOUDFLARE

# Proveedor alternativo: service_account. No se usa si el proveedor es apps_script.
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@example-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=CONFIGURAR_COMO_SECRETO_EN_CLOUDFLARE
